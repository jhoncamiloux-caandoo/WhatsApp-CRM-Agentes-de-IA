  "steps": [
    {
      "id": "pedido",
      "title": "You describe what you need",
      "subtitle": "A plain-language request, no setup required",
      "userMessage": "When a lead enters Qualification, I want the AI to answer on WhatsApp. If they go quiet, follow up. If they reply, move them to negotiation.",
      "aiMessage": "Got it! I'll build a follow-up automation for leads in Qualification: AI-led conversation, a reminder if there's no reply, and pipeline progress when the lead engages.",
      "resultCard": null,
      "canvasOps": [],
      "activeTab": "editor",
      "durationMs": 7000
    },
    {
      "id": "gatilho",
      "title": "Setting the trigger",
      "subtitle": "The automation starts when the deal changes stage",
      "aiMessage": "First, the trigger: the automation starts whenever a deal enters the Qualification stage of the Sales pipeline.",
      "resultCard": {
        "nodeType": "trigger",
        "title": "Start when…",
        "detail": "Deal entered the Qualification stage"
      },
      "canvasOps": [
        {
          "op": "addNode",
          "id": "n1",
          "type": "trigger",
          "position": {
            "x": 0,
            "y": 140
          },
          "data": {
            "title": "Start when…",
            "label": "Deal entered stage",
            "value": "Qualification",
            "meta": "Sales pipeline"
          }
        }
      ],
      "activeTab": "editor",
      "durationMs": 6000
    },
    {
      "id": "agente",
      "title": "Putting the AI to work",
      "subtitle": "The agent replies on WhatsApp with the deal's context",
      "aiMessage": "Now I'm connecting an AI agent to Official WhatsApp. It greets the lead, understands what they need and logs everything in the CRM.",
      "resultCard": {
        "nodeType": "agent",
        "title": "Start conversation",
        "detail": "Qualifier agent · Official WhatsApp"
      },
      "canvasOps": [
        {
          "op": "addNode",
          "id": "n2",
          "type": "agent",
          "position": {
            "x": 420,
            "y": 100
          },
          "data": {
            "title": "Start conversation",
            "device": "Official WhatsApp · Sales",
            "agent": "Qualifier",
            "prompt": "You are the sales assistant. Understand the lead's needs and log them in the CRM."
