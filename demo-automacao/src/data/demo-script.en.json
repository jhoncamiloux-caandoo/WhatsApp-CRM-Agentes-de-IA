        },
        {
          "op": "addEdge",
          "id": "e1",
          "source": "n1",
          "target": "n2"
        }
      ],
      "activeTab": "editor",
      "durationMs": 6500
    },
    {
      "id": "condicao",
      "title": "Checking whether the lead replied",
      "subtitle": "A branch separates engaged leads from silent ones",
      "aiMessage": "I added a condition: if the lead replies within 1 hour, they move to negotiation. If not, they enter the follow-up flow.",
      "resultCard": {
        "nodeType": "condition",
        "title": "Conversation interaction",
        "detail": "Replied · No reply in 1h"
      },
      "canvasOps": [
        {
          "op": "addNode",
          "id": "n3",
          "type": "condition",
          "position": {
            "x": 840,
            "y": 100
          },
          "data": {
            "title": "Conversation interaction",
            "branches": [
              {
                "id": "yes",
                "label": "If the lead replies"
              },
              {
                "id": "no",
                "label": "If no reply within 1 hour",
                "tone": "danger"
              }
            ]
          }
        },
        {
          "op": "addEdge",
          "id": "e2",
          "source": "n2",
          "target": "n3"
        }
      ],
      "activeTab": "editor",
      "durationMs": 6500
    },
